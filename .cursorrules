# ============================================================
#               GLOBAL RULES FOR ANDROID ML APP
# ============================================================

rules:

  # -----------------------------------------------------------
  # 1. ARCHITECTURE — Clean Architecture + MVVM
  # -----------------------------------------------------------
  - name: architecture
    description: >
      Проект использует Clean Architecture:
      ui/ — презентационный слой (Compose + M3)
      domain/ — бизнес-логика и UseCases
      data/ — репозитории, работа с bitmap и storage
      ml/ — TensorFlow Lite и image preprocessing.
      ViewModel управляет состоянием, но не содержит бизнес-логики.
    patterns:
      - "**/*.kt"
    behavior:
      - "Соблюдай иерархию: ui -> domain -> data/ml."
      - "Никогда не вызывай ml или data из ui напрямую."
      - "Никаких Android классов в domain."
      - "ML-инференс находится только в ml/ модуле."
      - "ViewModel не должна содержать тяжелых ML операций."

  # -----------------------------------------------------------
  # 2. UI — Jetpack Compose + Material Design 3 Guidelines
  # -----------------------------------------------------------
  - name: material_ui
    description: >
      Все UI реализуется через Jetpack Compose и следует Material Design 3.
    patterns:
      - "app/src/main/java/**/ui/**/*.kt"
    behavior:
      - "Используй Material 3 компоненты (Buttons, Cards, TopBar, NavigationBar)."
      - "Используй MaterialTheme (typography, colorScheme, shapes)."
      - "Соблюдай адаптивность: responsive layout для телефонов/планшетов."
      - "Не помещай логику работы с bitmap или ML внутри composables."
      - "Состояние UI поднимается (state hoisting)."

  # -----------------------------------------------------------
  # 3. ML / TensorFlow Lite Rules
  # -----------------------------------------------------------
  - name: ml
    patterns:
      - "app/src/main/java/**/ml/**/*.kt"
      - "**/*.tflite"
    behavior:
      - "Все ML операции реализуются через TFLite Interpreter."
      - "Обработка изображений — строго оффлайн."
      - "Не генерировать tflite модели."
      - "Модели не менять без прямого запроса."
      - "Bitmap preprocessing и постобработка выполняются в ml/."
      - "ViewModel и UI не должны напрямую работать с TensorBuffer."

  # -----------------------------------------------------------
  # 4. Data Layer Rules
  # -----------------------------------------------------------
  - name: data
    patterns:
      - "app/src/main/java/**/data/**/*.kt"
    behavior:
      - "Репозитории обеспечивают работу с изображениями, storage, кешем."
      - "ML-инференс нельзя размещать в data."
      - "Data конвертирует bitmap <-> файл, но не изменяет логику обработки."

  # -----------------------------------------------------------
  # 5. Domain Layer Rules
  # -----------------------------------------------------------
  - name: domain
    patterns:
      - "app/src/main/java/**/domain/**/*.kt"
    behavior:
      - "UseCase содержит только бизнес-логику."
      - "UseCase обращается только к репозиторию."
      - "UseCase НЕ должен знать про TFLite, Bitmap, ByteBuffer."
      - "Domain — чистый, без Android зависимостей."

  # -----------------------------------------------------------
  # 6. Dependency Injection (Hilt)
  # -----------------------------------------------------------
  - name: di
    patterns:
      - "**/*.kt"
    behavior:
      - "Все репозитории биндятся как интерфейсы через @Binds."
      - "TFLite Interpreter создаётся через @Provides."
      - "Не использовать Service Locator."

  # -----------------------------------------------------------
  # 7. Gradle Safety Rules
  # -----------------------------------------------------------
  - name: gradle
    patterns:
      - "*.gradle"
      - "*.gradle.kts"
    behavior:
      - "Объясняй каждое изменение зависимостей."
      - "tflite модели размещаются в assets/."
      - "Не менять minSdk/targetSdk без необходимости."

  # -----------------------------------------------------------
  # 8. Safety Rules
  # -----------------------------------------------------------
  - name: safety
    behavior:
      - "AI не должен удалять файлы без прямого запроса."
      - "Не редактировать tflite модели."
      - "Не добавлять сетевые вызовы — приложение оффлайн."
      - "Не переписывать архитектуру без запроса."

# ============================================================
#                   AGENT BEHAVIOR
# ============================================================

agents:
  default:
    strategy:
      - "Сначала проанализируй структуру проекта."
      - "Предлагай минимальные правки."
      - "Соблюдай Clean Architecture и M3."

  refactor:
    behavior:
      - "Не изменять конвейер ML без причины."
      - "Сохранять функциональность неизменной."
      - "Документировать важные изменения."

  generate:
    behavior:
      - "Генерировать код строго в рамках структуры проекта."
      - "UI должен соответствовать Material Design 3."
      - "ML код — только в ml/ слое."
      - "Не генерировать новую tflite модель."

  docs:
    behavior:
      - "KDoc обязателен для публичных классов."
      - "ML pipeline документируется кратко и понятно."

# ============================================================
#              DIRECTORY-SPECIFIC BEHAVIOR
# ============================================================

directories:

  "ml/":
    description: ML слой.
    behavior:
      - "Модель, интерпретатор, препроцессинг, постпроцессинг."
      - "Никаких импортов ui/ и data/."

  "ui/":
    description: Compose UI слой.
    behavior:
      - "Все экраны используют M3 компоненты."
      - "UI получает state только из ViewModel."

  "domain/":
    description: Чистая бизнес-логика.
    behavior:
      - "Только Kotlin-бизнес-логика, никакого ML."

  "data/":
    description: Работа с файлами, storage, bitmap.
    behavior:
      - "Нет прямых вызовов TensorFlow Lite."

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.NeuralPhotoRedactor" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Тема для Splash Screen -->
    <style name="Theme.NeuralPhotoRedactor.Splash" parent="Theme.SplashScreen">
        <!-- Фоновое изображение через windowBackground для полноэкранного отображения -->
        <item name="android:windowBackground">@drawable/splash_direct</item>
        <!-- Также устанавливаем через windowSplashScreenBackground для совместимости -->
        <item name="windowSplashScreenBackground">@drawable/splash_direct</item>
        <!-- Продолжительность анимации появления (в миллисекундах) -->
        <item name="windowSplashScreenAnimationDuration">300</item>
        <!-- Указываем тему после закрытия splash screen для правильного перехода -->
        <item name="postSplashScreenTheme">@style/Theme.NeuralPhotoRedactor</item>
    </style>
</resources>